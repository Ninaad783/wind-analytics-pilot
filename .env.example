# Application Configuration
APP_NAME="UK Wind Forecasting Analytics API"
ENVIRONMENT=production
DEBUG=false

# Elexon BMRS API Key (Optional for live API queries; if omitted, high-fidelity January 2026 benchmark is used)
ELEXON_API_KEY=your_elexon_api_key_here
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
REQUEST_TIMEOUT_SECONDS=10.0

# Day-Ahead Purchasing Decision Cutoff (Hour UTC on D-1)
DEFAULT_CUTOFF_HOUR_UTC=17
DEFAULT_CUTOFF_MINUTE_UTC=0

# Security & CORS
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
CACHE_TTL_SECONDS=300
